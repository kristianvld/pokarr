{
  "name": "pokarr",
  "private": true,
  "version": "0.1.4",
  "license": "Apache-2.0",
  "homepage": "https://github.com/kristianvld/pokarr",
  "repository": {
    "type": "git",
    "url": "https://github.com/kristianvld/pokarr.git"
  },
  "bugs": {
    "url": "https://github.com/kristianvld/pokarr/issues"
  },
  "engines": {
    "bun": ">=1.4.4"
  },
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev": "HOST=127.0.0.1 POKARR_DATA_DIR=.dev-data bun --watch server.ts",
    "dev:server": "HOST=127.0.0.1 POKARR_DATA_DIR=.dev-data bun --watch server.ts",
    "doctor": "react-doctor . --yes --verbose",
    "doctor:score": "react-doctor . --yes --score",
    "lint": "eslint . --max-warnings 0",
    "test": "bun test",
    "typecheck": "tsc -p tsconfig.client.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "build": "bun run scripts/build-app.ts",
    "start": "bun run scripts/start-built.ts",
    "check": "bun run lint && bun test && bun run typecheck && bun run build && vitepress build docs",
    "smoke:built": "bun run scripts/smoke-built-ui.ts",
    "check:prod": "bun run check && bun run smoke:built",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:snapshot": "bun run scripts/snapshot-docs.ts",
    "audit": "bun audit --audit-level=high"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.108.0",
    "@tanstack/react-query-devtools": "^5.108.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-switch": "^1.4.1",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "bun-plugin-tailwind": "0.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "lucide-react": "^0.511.0",
    "react": "^19.3.1",
    "react-doctor": "0.0.30",
    "react-dom": "^19.3.1",
    "playwright": "^1.65.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vitepress": "^1.6.4"
  },
  "overrides": {
    "vite": "^6.4.4"
  }
}
